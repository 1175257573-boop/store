# ===== 环境变量示例 =====
# 复制为 .env 并按本机实际情况修改（.env 已被 .gitignore 忽略，不会提交）
# 或直接用系统环境变量：export DB_PASSWORD=xxx

# MySQL 数据库
DB_URL=jdbc:mysql://localhost:3306/ecommerce?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=你的数据库密码

# JWT 签名密钥（生产环境务必替换为随机值）
# 生成方式：openssl rand -base64 48
ECOMMERCE_JWT_SECRET=请替换为随机密钥
